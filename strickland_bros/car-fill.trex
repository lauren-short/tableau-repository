<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.reflexblu.carfillviz" extension-version="2.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Liquid-fill car icon mark type. Drag a dimension onto "Color" (e.g. Net New Y/blank) and a measure onto "Size" (e.g. CNTD(VehicleVin)) to render a car filled by category, with configurable colors per value.</description>
    <author name="Lauren Short" email="lauren@reflexblu.com" organization="Reflex Blu" website="https://reflexblu.com"/>
    <min-api-version>1.10</min-api-version>

    <!--
      Hosted via GitHub Pages. NOTE: jsDelivr deliberately serves all
      .html files with Content-Type: text/plain (a security measure on
      their end) — it cannot be used to host this file, even though it
      works fine for .js libraries. GitHub Pages serves correct
      content-types and is the right host for this.
    -->
    <source-location>
      <url>https://lauren-short.github.io/tableau-repository/strickland_bros/index.html</url>
    </source-location>

    <icon/>

    <context-menu>
      <configure-context-menu-item />
    </context-menu>

    <encoding id="color">
      <display-name resource-id="color-name">Color</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="color"/>
      <tooltip resource-id="color-tooltip">Dimension whose values determine the colored segments (e.g. Net New: Y or blank). Blank/empty values become the "remaining" segment; any other value gets its own colored band.</tooltip>
    </encoding>

    <encoding id="size">
      <display-name resource-id="size-name">Size</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-a"/>
      <tooltip resource-id="size-tooltip">The measure to total per category (e.g. CNTD(VehicleVin))</tooltip>
    </encoding>

    <encoding id="label">
      <display-name resource-id="label-name">Label</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-c"/>
      <tooltip resource-id="label-tooltip">Optional: a text/calculated field to use as the subtitle under the percentage, instead of the default "highlighted / total" text</tooltip>
    </encoding>

    <encoding id="hoverInfo">
      <display-name resource-id="hover-info-name">Hover Info</display-name>
      <fields max-count="1"/>
      <encoding-icon token="letter-b"/>
      <tooltip resource-id="hover-info-tooltip">Any field shown in a custom popup when hovering a colored band. Not the same as the built-in Tooltip tile below — use this one.</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Car Fill Gauge</text>
    </resource>
    <resource id="color-name">
      <text locale="en_US">Color</text>
    </resource>
    <resource id="color-tooltip">
      <text locale="en_US">Dimension whose values determine the colored segments. Blank values become the remaining segment.</text>
    </resource>
    <resource id="size-name">
      <text locale="en_US">Size</text>
    </resource>
    <resource id="size-tooltip">
      <text locale="en_US">The measure to total per category, e.g. CNTD(VehicleVin)</text>
    </resource>
    <resource id="label-name">
      <text locale="en_US">Label</text>
    </resource>
    <resource id="label-tooltip">
      <text locale="en_US">Optional text or calculated field shown as the subtitle instead of the default highlighted/total text</text>
    </resource>
    <resource id="hover-info-name">
      <text locale="en_US">Hover Info</text>
    </resource>
    <resource id="hover-info-tooltip">
      <text locale="en_US">Any field shown in a custom popup on hover — separate from the built-in Tooltip tile</text>
    </resource>
  </resources>
</manifest>
