<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.reflexblu.carfillviz" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Liquid-fill car icon mark type. Drag a measure onto "Filled" and one onto "Remaining" to render a car icon filled to that proportion.</description>
    <author name="Lauren Short" email="lauren@reflexblu.com" organization="Reflex Blu" website="https://reflexblu.com"/>
    <min-api-version>1.1</min-api-version>

    <source-location>
      <url>https://cdn.jsdelivr.net/gh/lauren-short/tableau-repository@main/strickland_bros/viz-extension/index.html</url>
    </source-location>

    <icon/>

    <encoding id="filled">
      <display-name resource-id="filled-name">Filled</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-a"/>
      <tooltip resource-id="filled-tooltip">The measure representing the "filled" portion (e.g. Existing Vehicle Vin)</tooltip>
    </encoding>

    <encoding id="remaining">
      <display-name resource-id="remaining-name">Remaining</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
      <encoding-icon token="letter-b"/>
      <tooltip resource-id="remaining-tooltip">The measure representing the "remaining" or "empty" portion (e.g. New Cars)</tooltip>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Car Fill Gauge</text>
    </resource>
    <resource id="filled-name">
      <text locale="en_US">Filled</text>
    </resource>
    <resource id="filled-tooltip">
      <text locale="en_US">The measure representing the filled portion (e.g. Existing Vehicle Vin)</text>
    </resource>
    <resource id="remaining-name">
      <text locale="en_US">Remaining</text>
    </resource>
    <resource id="remaining-tooltip">
      <text locale="en_US">The measure representing the remaining or empty portion (e.g. New Cars)</text>
    </resource>
  </resources>
</manifest>
