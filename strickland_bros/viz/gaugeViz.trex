<?xml version='1.0' encoding='utf-8' ?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.reflexblu.extensions.gaugeviz" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Odometer-style gauge with colored segments and a needle, native tooltips included.</description>
    <author name="Lauren Short" email="lauren.short@reflexblu.com" organization="Reflex Blu" website="https://www.reflexblu.com"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <url>https://lauren-short.github.io/tableau-repository/strickland_bros/viz/index.html</url>
    </source-location>
    <icon></icon>
    <encoding id="level">
      <display-name>Level</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <encoding-icon token="level" />
    </encoding>
    <encoding id="angle">
      <display-name>Angle</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <encoding-icon token="level-radial" />
    </encoding>
  </worksheet-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Gauge Chart</text>
    </resource>
  </resources>
</manifest>
